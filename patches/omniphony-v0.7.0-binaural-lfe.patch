+    fn binaural_lfe_gain_db_round_trips_through_config() {
+        let env = OptionEnv::detached();
+        let spec = find("binaural_lfe_gain_db").expect("binaural_lfe_gain_db is declared");
+        let mut live = LiveParams::default();
+        assert_eq!(
+            live.binaural.lfe_gain_db,
+            crate::binaural::DIRECT_EAR_GAIN_DB
+        );
+        assert!((spec.set)(&mut live, &RawOptionValue::Number(5.5), &env).is_some());
+        assert_eq!(live.binaural.lfe_gain_db, 5.5);
+        let mut render = RenderConfig::default();
+        (spec.config_store)(&mut render, &live, &env);
+        assert_eq!(
+            render.binaural.as_ref().and_then(|b| b.lfe_gain_db),
+            Some(5.5)
+        );
+        let mut seeded = LiveParams::default();
+        (spec.config_seed)(&mut seeded, &render, &env);
+        assert_eq!(seeded.binaural.lfe_gain_db, 5.5);
+    }
+
+    #[test]
+    fn binaural_lfe_lowpass_hz_round_trips_through_config() {
+        let env = OptionEnv::detached();
+        let spec = find("binaural_lfe_lowpass_hz").expect("binaural_lfe_lowpass_hz is declared");
+        let mut live = LiveParams::default();
+        assert_eq!(live.binaural.lfe_lowpass_hz, None);
+        assert!((spec.set)(&mut live, &RawOptionValue::Number(120.0), &env).is_some());
+        assert_eq!(live.binaural.lfe_lowpass_hz, Some(120));
+        assert_eq!((spec.get_json)(&live), serde_json::json!(120));
+        let mut render = RenderConfig::default();
+        (spec.config_store)(&mut render, &live, &env);
+        assert_eq!(
+            render.binaural.as_ref().and_then(|b| b.lfe_lowpass_hz),
+            Some(120)
+        );
+        let mut seeded = LiveParams::default();
+        (spec.config_seed)(&mut seeded, &render, &env);
+        assert_eq!(seeded.binaural.lfe_lowpass_hz, Some(120));
+
+        assert!((spec.set)(&mut live, &RawOptionValue::Null, &env).is_some());
+        assert_eq!(live.binaural.lfe_lowpass_hz, None);
+        assert_eq!((spec.get_json)(&live), serde_json::Value::Null);
+        (spec.config_store)(&mut render, &live, &env);
+        assert_eq!(
