+    /// Sample `i` of a 48 kHz sine of amplitude 1.0 at `freq` Hz.
+    fn sine_48k(freq: f64, i: usize) -> f32 {
+        (std::f64::consts::TAU * freq * i as f64 / 48_000.0).sin() as f32
+    }
+
+    /// Level in dB of a 48 kHz sine at `freq` through the LFE low-pass at
+    /// `corner`: output RMS against input RMS over the second of two seconds.
+    fn lfe_lowpass_level_db(corner: Option<u32>, freq: f64) -> f64 {
+        let mut lp = LfeLowpass::new();
+        let n = 96_000;
+        let (mut in_sq, mut out_sq) = (0.0f64, 0.0f64);
+        for i in 0..n {
+            let x = sine_48k(freq, i);
+            let y = lp.process(x, corner, 48_000);
+            if i >= n / 2 {
+                in_sq += f64::from(x) * f64::from(x);
+                out_sq += f64::from(y) * f64::from(y);
+            }
+        }
+        10.0 * (out_sq / in_sq).log10()
+    }
