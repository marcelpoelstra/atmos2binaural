+    #[test]
+    fn binaural_hrtf_share_round_trips_through_config() {
+        let env = OptionEnv::detached();
+        let spec = find("binaural_hrtf_share").expect("binaural_hrtf_share is declared");
+        let mut live = LiveParams::default();
+        assert_eq!(live.binaural.hrtf_share, 1.0);
+        assert!((spec.set)(&mut live, &RawOptionValue::Number(0.15), &env).is_some());
+        assert_eq!(live.binaural.hrtf_share, 0.15);
+        let mut render = RenderConfig::default();
+        (spec.config_store)(&mut render, &live, &env);
+        assert_eq!(
+            render.binaural.as_ref().and_then(|b| b.hrtf_share),
+            Some(0.15)
+        );
+        let mut seeded = LiveParams::default();
+        (spec.config_seed)(&mut seeded, &render, &env);
+        assert_eq!(seeded.binaural.hrtf_share, 0.15);
+    }
+
+    #[test]
+    fn binaural_direction_normalize_round_trips_through_config() {
+        let env = OptionEnv::detached();
+        let spec =
+            find("binaural_direction_normalize").expect("binaural_direction_normalize is declared");
+        let mut live = LiveParams::default();
+        assert!(!live.binaural.direction_normalize);
+        assert!((spec.set)(&mut live, &RawOptionValue::Bool(true), &env).is_some());
+        assert!(live.binaural.direction_normalize);
+        let mut render = RenderConfig::default();
+        (spec.config_store)(&mut render, &live, &env);
+        assert_eq!(
+            render.binaural.as_ref().and_then(|b| b.direction_normalize),
+            Some(true)
+        );
+        let mut seeded = LiveParams::default();
+        (spec.config_seed)(&mut seeded, &render, &env);
+        assert!(seeded.binaural.direction_normalize);
+    }
+
+    #[test]
+    fn binaural_zone_gains_db_round_trips_through_config() {
+        let env = OptionEnv::detached();
