+/// How the direct path balances its sources. The default renders as the
+/// path always did: the HRTF alone, each direction at its own level, no
+/// offsets.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DirectBalance {
+    /// Share of the HRTF render in each source's direct sound, 0 to 1; the
+    /// rest is amplitude-panned between the ears ([`pan_gains`]). The
+    /// reflections and the reverb keep their own level.
+    pub hrtf_share: f32,
+    /// Scale each direction's HRIR pair to the energy of the pair at 30° to
+    /// the front, ear level, so that every direction reaches the ears at one
+    /// power.
+    pub normalize: bool,
+    /// Offsets in dB of the centre, surround and height zones
+    /// ([`zone_weights`]), applied to a source in proportion to how far it
+    /// sits in each.
+    pub zone_gains_db: [f32; 3],
+}
+
+impl Default for DirectBalance {
+    fn default() -> Self {
+        Self {
+            hrtf_share: 1.0,
+            normalize: false,
+            zone_gains_db: [0.0; 3],
+        }
+    }
+}
+
+impl DirectBalance {
+    /// Linear gain of a source at `pos` from the zone offsets.
+    fn zone_gain(&self, pos: [f64; 3]) -> f32 {
+        if self.zone_gains_db == [0.0; 3] {
+            return 1.0;
+        }
+        let db: f32 = zone_weights(pos)
+            .iter()
+            .zip(self.zone_gains_db)
+            .map(|(w, g)| w * g)
+            .sum();
+        crate::dsp::db::db_to_linear(db)
+    }
+}
+
+/// How far a source at `pos` (world ADM position) sits in the centre, the
+/// surround and the height zone, each 0 to 1, from its direction:
+/// - height: the elevation over 30°, capped at 1;
+/// - surround: 0 within 45° of the front, 1 from 90° on, linear between;
+/// - centre: 1 straight ahead, 0 from 30° on, linear between, shrinking as
+///   the height weight grows.
+pub(crate) fn zone_weights(pos: [f64; 3]) -> [f32; 3] {
+    let [x, y, z] = pos;
+    let norm = (x * x + y * y + z * z).sqrt();
+    if norm < 1e-9 {
+        return [0.0; 3];
+    }
+    let el = (z / norm).clamp(-1.0, 1.0).asin().to_degrees();
+    let az = x.atan2(y).to_degrees().abs();
+    let height = (el / 30.0).clamp(0.0, 1.0);
+    let surround = ((az - 45.0) / 45.0).clamp(0.0, 1.0);
+    let centre = (1.0 - az / 30.0).clamp(0.0, 1.0) * (1.0 - height);
+    [centre as f32, surround as f32, height as f32]
+}
+
+/// Amplitude-panning gains `(left, right)` of a source at lateral position
+/// `lat` (the head-relative x of its unit direction, −1 left to +1 right):
+/// their difference over their sum is `lat / sin 30°`, clamped to a hard
+/// pan, at constant power. Straight ahead, each ear gets 0.707.
+pub(crate) fn pan_gains(lat: f32) -> (f32, f32) {
+    let r = (2.0 * lat).clamp(-1.0, 1.0);
+    let norm = (2.0 * (1.0 + r * r)).sqrt();
+    ((1.0 - r) / norm, (1.0 + r) / norm)
+}
+
+/// Energy of the first `len` taps of both ears of `pair`.
+fn pair_energy(pair: &HrirPair, len: usize) -> f32 {
+    pair.left[..len]
+        .iter()
+        .chain(&pair.right[..len])
+        .map(|v| v * v)
+        .sum()
+}
