+    // ── Direct balance: HRTF share, level match, zone offsets ──────────────
+
+    /// Unit direction at azimuth `az` (degrees, + right) and elevation `el`.
+    fn dir(az: f64, el: f64) -> [f64; 3] {
+        let (a, e) = (az.to_radians(), el.to_radians());
+        [a.sin() * e.cos(), a.cos() * e.cos(), e.sin()]
+    }
+
+    /// `dry_params` with `balance`, and no ITD: a fractional delay would
+    /// take energy off an impulse and hide what the balance does.
+    fn balanced(balance: DirectBalance) -> BinauralFrameParams {
+        BinauralFrameParams {
+            head_radius_m: 0.0,
+            balance,
+            ..dry_params()
+        }
+    }
+
+    /// Interleaved output of an impulse at `pos` through `params`, after a
+    /// silent block that runs the kernel crossfade out (see `render_single`).
+    fn impulse_out(params: &BinauralFrameParams, pos: [f64; 3]) -> Vec<f32> {
+        let mut r = BinauralRenderer::new(48_000);
+        let n = 512;
+        let mut warm = vec![0.0f32; n * 2];
+        r.render_frame(
+            &vec![0.0f32; n],
+            1,
+            n,
+            params,
+            &[pos],
+            &[ChannelGain::flat(1.0)],
+            &[],
+            None,
+            &mut warm,
+        );
+        let mut input = vec![0.0f32; n];
+        input[0] = 1.0;
+        let mut out = vec![0.0f32; n * 2];
+        r.render_frame(
+            &input,
+            1,
+            n,
+            params,
+            &[pos],
+            &[ChannelGain::flat(1.0)],
+            &[],
+            None,
+            &mut out,
+        );
+        out
+    }
+
+    /// Energy of the left and the right ear in `out`.
+    fn ear_energy(out: &[f32]) -> (f32, f32) {
+        let l = out.iter().step_by(2).map(|v| v * v).sum();
+        let r = out.iter().skip(1).step_by(2).map(|v| v * v).sum();
+        (l, r)
+    }
