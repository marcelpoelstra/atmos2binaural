+            Some([2.0, -4.5, -3.0])
+        );
+        let mut seeded = LiveParams::default();
+        (spec.config_seed)(&mut seeded, &render, &env);
+        assert_eq!(seeded.binaural.zone_gains_db, [2.0, -4.5, -3.0]);
+    }
