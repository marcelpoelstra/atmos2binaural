+        let mut live = LiveParams::default();
+        assert_eq!(live.binaural.zone_gains_db, [0.0; 3]);
+        let raw = RawOptionValue::Numbers(&[2.0, -4.5, -3.0]);
+        assert!((spec.set)(&mut live, &raw, &env).is_some());
+        assert_eq!(live.binaural.zone_gains_db, [2.0, -4.5, -3.0]);
+        assert_eq!((spec.get_json)(&live), serde_json::json!([2.0, -4.5, -3.0]));
+        let mut render = RenderConfig::default();
+        (spec.config_store)(&mut render, &live, &env);
